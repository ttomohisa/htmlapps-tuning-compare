{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Tuning Compare",
  "nameJa": "音律聞き比べ",
  "slug": "tuning-compare",
  "version": "0.4.0",
  "description": "Create a short two-measure score and hear it with equal temperament, 5-limit just intonation, or exact custom A/B tunings.",
  "descriptionJa": "2小節の簡易譜面を作り、平均律・5-limit純正律・カスタム音律のA/B設定で再生して聞き比べます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-tuning-compare"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 3,
      "selfExtractWarningMb": 1
    }
  }
}
