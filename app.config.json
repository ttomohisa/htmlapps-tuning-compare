{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Tuning Compare",
  "nameJa": "音律聞き比べ",
  "slug": "tuning-compare",
  "version": "0.3.0",
  "description": "Compare equal temperament, 5-limit just intonation, and exact custom frequencies with synchronized A/B playback in the browser.",
  "descriptionJa": "平均律・5-limit純正律・カスタム音律を、同じ再生位置でA/B切り替えして聞き比べます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-tuning-compare"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 3,
      "selfExtractWarningMb": 1
    }
  }
}
