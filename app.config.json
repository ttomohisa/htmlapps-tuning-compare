{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Tuning Compare",
  "nameJa": "音律聞き比べ",
  "slug": "tuning-compare",
  "version": "0.2.0",
  "description": "Calculate and audition equal temperament, 5-limit just intonation, and exact custom note frequencies in the browser.",
  "descriptionJa": "12平均律・5-limit純正律・カスタム音律の周波数を計算し、その場で試聴できます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-tuning-compare"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 3,
      "selfExtractWarningMb": 1
    }
  }
}
