{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Tuning Compare",
  "nameJa": "音律聞き比べ",
  "slug": "tuning-compare",
  "version": "0.7.0",
  "description": "Compare tunings, edit custom scales in Hz, ratios, or cents, save full projects as JSON, and export local WAV audio.",
  "descriptionJa": "音律を聞き比べ、カスタム音律をHz・比率・cent差で編集し、譜面や設定をプロジェクトJSONとして保存・復元できます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-tuning-compare"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 3,
      "selfExtractWarningMb": 1
    }
  }
}
